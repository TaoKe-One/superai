# Command-line deployment. Compose sets these values inside the container.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# Published host address and port for Docker Compose.
PUBLISH_HOST=127.0.0.1
PUBLISH_PORT=8787

# Set to false to disable the built-in update service.
# SUPERAI_UPDATES=false

# Optional. Leave empty to generate a key in the data directory.
# Preserve the same value across restarts if you set your own key.
MASTER_KEY=

# Enable for HTTPS or a trusted reverse proxy that overwrites X-Forwarded-For.
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional troubleshooting settings.
MIOT_LOGIN_DIAGNOSTICS=false
LX_DNS_OVER_HTTPS=true

# Optional music URL relay. See docs/deployment.md for LAN and Docker setup.
# SPEAKER_RELAY_HOST=192.168.1.10
# SPEAKER_RELAY_PORT=8788
# SPEAKER_RELAY_BASE_URL=http://192.168.1.10:8788
